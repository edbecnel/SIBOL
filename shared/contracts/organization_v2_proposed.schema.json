{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SibolOrganizationV2Proposed",
  "description": "Proposed organization document extensions for ORG-IDENTITY. Does not replace organization.schema.json until implementation.",
  "allOf": [
    { "$ref": "organization.schema.json" }
  ],
  "type": "object",
  "properties": {
    "psgcVersion": { "type": "string", "maxLength": 64 },
    "psgcRegionCode": { "type": "string", "maxLength": 16 },
    "psgcProvinceCode": { "type": ["string", "null"], "maxLength": 16 },
    "psgcCityMunCode": { "type": "string", "maxLength": 16 },
    "psgcBarangayCode": { "type": "string", "maxLength": 16 },
    "officialBarangayName": { "type": "string", "maxLength": 200 },
    "psgcRegionName": { "type": "string", "maxLength": 200 },
    "psgcProvinceName": { "type": "string", "maxLength": 200 },
    "psgcCityMunName": { "type": "string", "maxLength": 200 },
    "displayNameAlias": { "type": "string", "maxLength": 200 },
    "nhfrSnapshotVersion": { "type": "string", "maxLength": 64 },
    "nhfrFacilityCode": { "type": "string", "maxLength": 32 },
    "facilityOfficialName": { "type": "string", "maxLength": 300 },
    "addressLine1": { "type": "string", "maxLength": 300 },
    "addressLine2": { "type": "string", "maxLength": 300 }
  },
  "additionalProperties": false
}
