rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny-by-default: only explicit paths below are reachable.

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return userDoc().role;
    }

    function isActiveUser() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().active == true;
    }

    function isTeen() {
      return isActiveUser() && userRole() == 'teen';
    }

    function isBarangay() {
      return isActiveUser() && userRole() == 'barangay';
    }

    function isMoph() {
      return isActiveUser() && userRole() == 'moph';
    }

    // --- REG-A: organizations and memberships (SIBOL-REG-001) ---

    function isValidOrgId(orgId) {
      return orgId is string
          && orgId.size() >= 1
          && orgId.size() <= 128
          && orgId != '.'
          && orgId != '..'
          && !orgId.matches('.*__.*')
          && !orgId.matches('.*/.*')
          && orgId.matches('^[A-Za-z0-9][A-Za-z0-9_-]*$');
    }

    function membershipDocIdForOrg(orgId) {
      return 'mbr_' + orgId + '__' + request.auth.uid;
    }

    function membershipDataForOrg(orgId) {
      return get(/databases/$(database)/documents/organizationMemberships/$(membershipDocIdForOrg(orgId))).data;
    }

    function membershipExistsActive(orgId) {
      return isSignedIn()
          && isValidOrgId(orgId)
          && exists(/databases/$(database)/documents/organizationMemberships/$(membershipDocIdForOrg(orgId)))
          && membershipDataForOrg(orgId).status == 'active'
          && membershipDataForOrg(orgId).orgId == orgId
          && membershipDataForOrg(orgId).accountUid == request.auth.uid;
    }

    function organizationIsActive(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId))
          && get(/databases/$(database)/documents/organizations/$(orgId)).data.status == 'active';
    }

    function capabilityGranted(orgId, cap) {
      return membershipExistsActive(orgId)
          && organizationIsActive(orgId)
          && membershipDataForOrg(orgId).keys().hasAll(['capabilities'])
          && membershipDataForOrg(orgId).capabilities is list
          && cap in membershipDataForOrg(orgId).capabilities;
    }

    function roleUnchanged() {
      return !('role' in request.resource.data)
          || request.resource.data.role == resource.data.role;
    }

    function profileCreateValid() {
      return request.resource.data.keys().hasAll(['role', 'displayName', 'active', 'createdAt'])
          && request.resource.data.role in ['teen', 'barangay', 'moph']
          && request.resource.data.active is bool
          && request.resource.data.displayName is string;
    }

    function isValidCaseStatus(status) {
      return status in ['active', 'followUpScheduled', 'followUpCompleted', 'closed'];
    }

    function isValidClientReportStatus(status) {
      return status in ['notSubmitted', 'pendingSubmit'];
    }

    function caseAllowedKeys() {
      return [
        'demoName', 'age', 'barangay', 'orgId', 'caseStatus', 'registeredAt',
        'nextFollowUpAt', 'notes', 'createdAt', 'updatedAt', 'reportStatus',
        'subjectKind', 'caseCompleteness', 'fullName', 'dateOfBirth',
        'contactEmail', 'contactPhone', 'parentGuardianContact',
        'teenUid', 'linkedAccountEmail', 'identityLinkedAt'
      ];
    }

    function caseIsLegacyDocument(data) {
      return !('caseCompleteness' in data);
    }

    function isValidSubjectKind(kind) {
      return kind in ['registered', 'unregistered'];
    }

    function isValidCaseCompleteness(status) {
      return status in ['draft', 'active', 'legacyIncomplete'];
    }

    function isValidDateOfBirthString(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function caseHasContactMethod(data) {
      return ('contactEmail' in data
              && data.contactEmail is string
              && data.contactEmail.size() >= 5)
          || ('contactPhone' in data
              && data.contactPhone is string
              && data.contactPhone.size() >= 7);
    }

    function teenAccountLinkedToOrg(teenUid, orgId) {
      return exists(/databases/$(database)/documents/users/$(teenUid))
          && get(/databases/$(database)/documents/users/$(teenUid)).data.role == 'teen'
          && get(/databases/$(database)/documents/users/$(teenUid)).data.active == true
          && get(/databases/$(database)/documents/users/$(teenUid)).data.selectedBarangayOrgId == orgId;
    }

    function caseLegacyCoreFieldsValid(data) {
      return data.keys().hasAll([
            'demoName', 'age', 'barangay', 'caseStatus', 'registeredAt',
            'createdAt', 'updatedAt', 'reportStatus'
          ])
          && data.keys().hasOnly(caseAllowedKeys())
          && data.demoName is string
          && data.demoName.size() >= 2
          && data.age is int
          && data.age >= 13
          && data.age <= 19
          && data.barangay is string
          && data.barangay.size() >= 1
          && isValidOrgId(data.orgId)
          && isValidCaseStatus(data.caseStatus)
          && data.registeredAt is timestamp
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && isValidClientReportStatus(data.reportStatus)
          && (!('nextFollowUpAt' in data) || data.nextFollowUpAt is timestamp)
          && (!('notes' in data) || data.notes is string);
    }

    function caseExtendedCoreFieldsValid(data) {
      return data.keys().hasAll([
            'demoName', 'fullName', 'age', 'barangay', 'orgId', 'caseStatus',
            'registeredAt', 'createdAt', 'updatedAt', 'reportStatus',
            'subjectKind', 'caseCompleteness'
          ])
          && data.keys().hasOnly(caseAllowedKeys())
          && data.demoName is string
          && data.demoName.size() >= 2
          && data.fullName is string
          && data.fullName.size() >= 2
          && isValidSubjectKind(data.subjectKind)
          && isValidCaseCompleteness(data.caseCompleteness)
          && data.age is int
          && ((data.caseCompleteness == 'draft'
                  && data.age >= 0
                  && data.age <= 19)
              || (data.age >= 13 && data.age <= 19))
          && data.barangay is string
          && data.barangay.size() >= 1
          && isValidOrgId(data.orgId)
          && isValidCaseStatus(data.caseStatus)
          && data.registeredAt is timestamp
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && isValidClientReportStatus(data.reportStatus)
          && (!('nextFollowUpAt' in data) || data.nextFollowUpAt is timestamp)
          && (!('notes' in data) || data.notes is string)
          && (!('dateOfBirth' in data) || isValidDateOfBirthString(data.dateOfBirth))
          && (!('contactEmail' in data) || data.contactEmail is string)
          && (!('contactPhone' in data) || data.contactPhone is string)
          && (data.caseCompleteness != 'active' || caseHasContactMethod(data))
          && (data.caseCompleteness != 'active'
              || ('dateOfBirth' in data && isValidDateOfBirthString(data.dateOfBirth)))
          && (data.subjectKind != 'registered'
              || ('teenUid' in data
                  && data.teenUid is string
                  && data.teenUid.size() >= 1
                  && teenAccountLinkedToOrg(data.teenUid, data.orgId)
                  && ('linkedAccountEmail' in data)
                  && data.linkedAccountEmail is string
                  && data.linkedAccountEmail.size() >= 3))
          && (data.subjectKind != 'unregistered' || !('teenUid' in data));
    }

    function caseTeenUidImmutable() {
      return !('teenUid' in resource.data)
          || !('teenUid' in request.resource.data)
          || request.resource.data.teenUid == resource.data.teenUid;
    }

    function caseSubjectKindImmutable() {
      return !('subjectKind' in resource.data)
          || request.resource.data.subjectKind == resource.data.subjectKind;
    }

    function teenProfileContactValid(data) {
      return caseHasContactMethod(data)
          || (('contactEmail' in data) == false && ('contactPhone' in data) == false);
    }

    function caseOrgIdImmutable() {
      return request.resource.data.orgId == resource.data.orgId;
    }

    function documentHasOrgId(data) {
      return data.keys().hasAll(['orgId']) && isValidOrgId(data.orgId);
    }

    function canReadCaseOrg(orgId) {
      return isActiveUser()
          && isValidOrgId(orgId)
          && capabilityGranted(orgId, 'case.read');
    }

    function canWriteCaseOrg(orgId) {
      return isActiveUser()
          && isValidOrgId(orgId)
          && capabilityGranted(orgId, 'case.write');
    }

    function parentCaseOrgId(caseId) {
      return get(/databases/$(database)/documents/cases/$(caseId)).data.orgId;
    }

    function userPrimaryOrgId() {
      return userDoc().primaryOrgId;
    }

    function teenSelectedBarangayOrgId() {
      return teenProfile().selectedBarangayOrgId;
    }

    function mophPrimaryOrgIdForCapability() {
      return userDoc().keys().hasAll(['primaryOrgId'])
          && userPrimaryOrgId() is string
          && userPrimaryOrgId().size() > 0
          && isValidOrgId(userPrimaryOrgId())
          ? userPrimaryOrgId()
          : null;
    }

    // Pilot: single demonstration hospital org when profile primaryOrgId is absent.
    function mophPilotHospitalOrgId() {
      return 'hospital01';
    }

    function mophHospitalCoordinationGranted() {
      return isMoph()
          && (
            (
              mophPrimaryOrgIdForCapability() != null
              && capabilityGranted(mophPrimaryOrgIdForCapability(), 'coordination.hospital')
            )
            || capabilityGranted(mophPilotHospitalOrgId(), 'coordination.hospital')
          );
    }

    function isValidAssistanceCategory(category) {
      return category in [
        'generalSupport',
        'healthInformation',
        'counselingReferral',
        'barangayServices'
      ];
    }

    function teenProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasAssignedBarangay(data) {
      return 'assignedBarangay' in data
          && data.assignedBarangay is string
          && data.assignedBarangay.size() >= 1;
    }

    function assistanceRequestCreateValid(data) {
      return data.keys().hasAll([
            'teenUid', 'barangay', 'orgId', 'category', 'description', 'status', 'createdAt'
          ])
          && data.keys().hasOnly([
            'teenUid', 'barangay', 'orgId', 'category', 'description', 'status', 'createdAt'
          ])
          && data.teenUid is string
          && data.teenUid == request.auth.uid
          && hasAssignedBarangay(teenProfile())
          && isValidOrgId(data.orgId)
          && isValidOrgId(teenSelectedBarangayOrgId())
          && data.orgId == teenSelectedBarangayOrgId()
          && organizationIsActive(data.orgId)
          && data.barangay == teenProfile().assignedBarangay
          && isValidAssistanceCategory(data.category)
          && data.description is string
          && data.description.size() >= 10
          && data.description.size() <= 500
          && data.status == 'submitted'
          && data.createdAt is timestamp;
    }

    function barangayCanAccessAssistanceRequest() {
      return documentHasOrgId(resource.data)
          && capabilityGranted(resource.data.orgId, 'coordination.barangay');
    }

    function assistanceRequestAcknowledgeUpdate() {
      return barangayCanAccessAssistanceRequest()
          && resource.data.status == 'submitted'
          && request.resource.data.status == 'acknowledged'
          && request.resource.data.teenUid == resource.data.teenUid
          && request.resource.data.barangay == resource.data.barangay
          && request.resource.data.orgId == resource.data.orgId
          && request.resource.data.category == resource.data.category
          && request.resource.data.description == resource.data.description
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.acknowledgedAt is timestamp
          && request.resource.data.acknowledgedByUid == request.auth.uid
          && request.resource.data.keys().hasAll([
            'teenUid', 'barangay', 'orgId', 'category', 'description', 'status', 'createdAt',
            'acknowledgedAt', 'acknowledgedByUid'
          ])
          && (!('submitterDisplayName' in resource.data)
              || request.resource.data.submitterDisplayName == resource.data.submitterDisplayName)
          && (!('submitterAccountEmail' in resource.data)
              || request.resource.data.submitterAccountEmail == resource.data.submitterAccountEmail)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['submitterDisplayName', 'submitterAccountEmail']);
    }

    function caseCoreFieldsValid(data) {
      return caseIsLegacyDocument(data)
          ? caseLegacyCoreFieldsValid(data)
          : caseExtendedCoreFieldsValid(data);
    }

    match /organizations/{orgId} {
      allow read: if membershipExistsActive(orgId) && organizationIsActive(orgId);

      allow create, update, delete: if false;
    }

    function organizationDirectoryDocValid(data) {
      return data.keys().hasAll(['orgId', 'name', 'type', 'status', 'updatedAt'])
          && data.orgId is string
          && data.name is string
          && data.name.size() >= 1
          && data.type in ['barangay', 'hospital']
          && data.status in ['pending', 'active', 'suspended']
          && data.updatedAt is timestamp
          && (!('geographicSiteLabel' in data)
              || (data.geographicSiteLabel is string && data.geographicSiteLabel.size() >= 1));
    }

    match /organizationDirectory/{orgId} {
      allow get: if isActiveUser()
          && isValidOrgId(orgId)
          && organizationDirectoryDocValid(resource.data)
          && resource.data.orgId == orgId;

      allow list: if false;

      allow create, update, delete: if false;
    }

    match /organizationMemberships/{membershipId} {
      allow read: if isSignedIn()
          && resource.data.keys().hasAll(['accountUid', 'orgId'])
          && resource.data.accountUid == request.auth.uid
          && isValidOrgId(resource.data.orgId)
          && membershipId == membershipDocIdForOrg(resource.data.orgId);

      allow create, update, delete: if false;
    }

    match /auditEvents/{eventId} {
      allow read, write: if false;
    }

    match /organizationStaffInvitations/{invitationId} {
      allow read, write: if false;
    }

    match /organizationIdentityKeys/{identityKey} {
      allow read, write: if false;
    }

    match /organizationCreationIdempotency/{idempotencyId} {
      allow read, write: if false;
    }

    match /assistanceSubmissionIdempotency/{idempotencyId} {
      allow read, write: if false;
    }

    match /assistanceAcknowledgmentIdempotency/{idempotencyId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if false;

      allow update: if isSignedIn()
          && request.auth.uid == userId
          && roleUnchanged()
          && request.resource.data.role == resource.data.role
          && !('isCentralAdmin' in request.resource.data)
          && (teenSelfProfileUpdate()
              || nonTeenDisplayNameOnlyUpdate());

      allow delete: if false;
    }

    function teenSelfProfileUpdate() {
      return isTeen()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'dateOfBirth', 'contactEmail', 'contactPhone',
            'assignedBarangay', 'parentGuardianContact'
          ])
          && (!('dateOfBirth' in request.resource.data)
              || isValidDateOfBirthString(request.resource.data.dateOfBirth))
          && teenProfileContactValid(request.resource.data);
    }

    function nonTeenDisplayNameOnlyUpdate() {
      return !isTeen()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName']);
    }

    match /cases/{caseId} {
      allow read: if documentHasOrgId(resource.data)
          && canReadCaseOrg(resource.data.orgId);

      allow create: if canWriteCaseOrg(request.resource.data.orgId)
          && caseCoreFieldsValid(request.resource.data)
          && request.resource.data.reportStatus == 'notSubmitted';

      allow update: if canWriteCaseOrg(resource.data.orgId)
          && caseCoreFieldsValid(request.resource.data)
          && caseOrgIdImmutable()
          && caseTeenUidImmutable()
          && caseSubjectKindImmutable()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.reportStatus == resource.data.reportStatus;

      allow delete: if false;

      match /followUps/{followUpId} {
        allow read: if canReadCaseOrg(parentCaseOrgId(caseId));

        allow create, update: if canWriteCaseOrg(parentCaseOrgId(caseId));

        allow delete: if false;
      }
    }

    match /teenAssistanceRequests/{requestId} {
      allow read: if (isTeen()
          && resource.data.teenUid == request.auth.uid)
          || barangayCanAccessAssistanceRequest();

      // Teen assistance creates are server-only (regSubmitTeenAssistanceRequest).
      allow create: if false;

      allow update: if assistanceRequestAcknowledgeUpdate();

      allow delete: if false;
    }

    function barangayReportStatusCountsValid(data) {
      return data.activeCaseCount is int
          && data.followUpScheduledCount is int
          && data.followUpCompletedCount is int
          && data.closedCaseCount is int
          && data.activeCaseCount >= 0
          && data.followUpScheduledCount >= 0
          && data.followUpCompletedCount >= 0
          && data.closedCaseCount >= 0
          && data.activeCaseCount + data.followUpScheduledCount
              + data.followUpCompletedCount + data.closedCaseCount
              == data.totalCaseCount;
    }

    function barangayReportCreateValid(data) {
      return data.keys().hasAll([
            'barangay', 'orgId', 'submittedAt', 'submittedByUid', 'totalCaseCount',
            'activeCaseCount', 'followUpScheduledCount', 'followUpCompletedCount',
            'closedCaseCount', 'reportStatus', 'acceptedAt'
          ])
          && data.keys().hasOnly([
            'barangay', 'orgId', 'submittedAt', 'submittedByUid', 'totalCaseCount',
            'activeCaseCount', 'followUpScheduledCount', 'followUpCompletedCount',
            'closedCaseCount', 'reportStatus', 'acceptedAt'
          ])
          && data.barangay is string
          && data.barangay.size() >= 1
          && isValidOrgId(data.orgId)
          && organizationIsActive(data.orgId)
          && capabilityGranted(data.orgId, 'report.submit')
          && data.submittedByUid == request.auth.uid
          && data.reportStatus == 'submitted'
          && data.submittedAt == request.time
          && data.acceptedAt == request.time
          && data.totalCaseCount is int
          && data.totalCaseCount >= 0
          && barangayReportStatusCountsValid(data);
    }

    function barangayCanReadSubmittedReport() {
      return resource.data.keys().hasAll(['orgId', 'reportStatus', 'acceptedAt'])
          && documentHasOrgId(resource.data)
          && capabilityGranted(resource.data.orgId, 'report.submit')
          && resource.data.reportStatus == 'submitted'
          && resource.data.acceptedAt != null;
    }

    function mophCanReadSubmittedReport() {
      return userRole() == 'moph'
          && mophHospitalCoordinationGranted()
          && resource.data.keys().hasAll(['acceptedAt', 'reportStatus'])
          && resource.data.acceptedAt != null
          && resource.data.reportStatus == 'submitted';
    }

    function barangayRoleCanReadSubmittedReport() {
      return userRole() == 'barangay' && barangayCanReadSubmittedReport();
    }

    match /reports/{reportId} {
      allow read: if mophCanReadSubmittedReport() || barangayRoleCanReadSubmittedReport();

      allow create: if barangayReportCreateValid(request.resource.data);

      allow update, delete: if false;
    }

    // --- Case coordination (SIBOL-CASE-COORD-001 Increment A) ---
    // Client referral creation and staff-event/phase writes deferred to callable (B) and rules (C).

    function isValidCoordinationPhase(phase) {
      return phase in ['referred', 'awaitingBarangay', 'awaitingMoph', 'closed'];
    }

    function coordinationThreadDoc(threadId) {
      return get(/databases/$(database)/documents/caseCoordinationThreads/$(threadId)).data;
    }

    function coordinationThreadOrgId(threadId) {
      return coordinationThreadDoc(threadId).orgId;
    }

    function barangayCanReadCoordinationThreadId(threadId) {
      return documentHasOrgId(coordinationThreadDoc(threadId))
          && capabilityGranted(coordinationThreadOrgId(threadId), 'coordination.barangay');
    }

    function coordinationThreadHasReadablePhase(threadId) {
      return coordinationThreadDoc(threadId).keys().hasAll(['phase'])
          && isValidCoordinationPhase(coordinationThreadDoc(threadId).phase);
    }

    function mophCanReadCoordinationThreadId(threadId) {
      return mophHospitalCoordinationGranted()
          && coordinationThreadHasReadablePhase(threadId);
    }

    function barangayCanReadCoordinationThread() {
      return documentHasOrgId(resource.data)
          && capabilityGranted(resource.data.orgId, 'coordination.barangay');
    }

    function mophCanReadCoordinationThread() {
      return userRole() == 'moph'
          && mophHospitalCoordinationGranted()
          && resource.data.keys().hasAll(['phase'])
          && isValidCoordinationPhase(resource.data.phase);
    }

    function barangayRoleCanReadCoordinationThread() {
      return userRole() == 'barangay' && barangayCanReadCoordinationThread();
    }

    match /caseCoordinationThreads/{threadId} {
      allow read: if mophCanReadCoordinationThread() || barangayRoleCanReadCoordinationThread();

      allow create, update, delete: if false;

      match /private/{docId} {
        allow read: if docId == 'binding'
            && barangayCanReadCoordinationThreadId(threadId);

        allow create, update, delete: if false;
      }

      match /staffEvents/{eventId} {
        allow read: if mophCanReadCoordinationThreadId(threadId)
            || barangayCanReadCoordinationThreadId(threadId);

        allow create, update, delete: if false;
      }
    }

    function assistanceRequestData(assistanceRequestId) {
      return get(/databases/$(database)/documents/teenAssistanceRequests/$(assistanceRequestId)).data;
    }

    function barangayCanReadCoordinationRegistry(assistanceRequestId) {
      return exists(/databases/$(database)/documents/teenAssistanceRequests/$(assistanceRequestId))
          && documentHasOrgId(assistanceRequestData(assistanceRequestId))
          && capabilityGranted(
              assistanceRequestData(assistanceRequestId).orgId, 'coordination.barangay')
          && (
            !exists(/databases/$(database)/documents/barangayCoordinationRegistry/$(assistanceRequestId))
            || (
              documentHasOrgId(
                  get(/databases/$(database)/documents/barangayCoordinationRegistry/$(assistanceRequestId)).data)
              && get(/databases/$(database)/documents/barangayCoordinationRegistry/$(assistanceRequestId)).data.orgId
                  == assistanceRequestData(assistanceRequestId).orgId
            )
          );
    }

    match /barangayCoordinationRegistry/{assistanceRequestId} {
      allow read: if barangayCanReadCoordinationRegistry(assistanceRequestId);

      allow create, update, delete: if false;
    }

    match /teenCoordinationLinks/{teenUid} {
      match /links/{assistanceRequestId} {
        allow read: if isTeen() && request.auth.uid == teenUid;

        allow create, update, delete: if false;
      }
    }

    match /staffProvisioningOperations/{operationId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
