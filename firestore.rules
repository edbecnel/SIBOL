rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny-by-default: only explicit paths below are reachable.

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return userDoc().role;
    }

    function isActiveUser() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().active == true;
    }

    function isTeen() {
      return isActiveUser() && userRole() == 'teen';
    }

    function isBarangay() {
      return isActiveUser() && userRole() == 'barangay';
    }

    function isMoph() {
      return isActiveUser() && userRole() == 'moph';
    }

    function roleUnchanged() {
      return !('role' in request.resource.data)
          || request.resource.data.role == resource.data.role;
    }

    function profileCreateValid() {
      return request.resource.data.keys().hasAll(['role', 'displayName', 'active', 'createdAt'])
          && request.resource.data.role in ['teen', 'barangay', 'moph']
          && request.resource.data.active is bool
          && request.resource.data.displayName is string;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      // Users may update display fields only; role is provisioned by trusted scripts/admin.
      allow create: if false;

      allow update: if isSignedIn()
          && request.auth.uid == userId
          && roleUnchanged()
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName']);

      allow delete: if false;
    }

    match /cases/{caseId} {
      allow read, create, update: if isBarangay();
      allow delete: if false;

      match /followUps/{followUpId} {
        allow read, create, update: if isBarangay();
        allow delete: if false;
      }
    }

    // MOPH reads only server-accepted reports (Tranche 2 submit function writes here).
    match /reports/{reportId} {
      allow read: if isMoph()
          && resource.data.acceptedAt != null
          && resource.data.reportStatus == 'submitted';
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
